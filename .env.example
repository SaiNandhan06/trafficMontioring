SPEED_DECELERATION_THRESHOLD=25.0
ACCIDENT_IOU_THRESHOLD=0.35
CONGESTION_DENSITY_THRESHOLD=0.60
INCIDENT_COOLDOWN_SECONDS=10

# ==============================================================================
# Blockchain & Smart Contracts
# ==============================================================================
ETH_RPC_URL=http://127.0.0.1:8545
CHAIN_ID=1337
CONTRACT_REGISTRY_ADDRESS=0x0000000000000000000000000000000000000000
CONTRACT_EMERGENCY_ADDRESS=0x0000000000000000000000000000000000000000
OPERATOR_PRIVATE_KEY=<YOUR_LOCAL_TEST_OR_OPERATOR_PRIVATE_KEY>
DRONE_PRIVATE_KEY=<YOUR_LOCAL_TEST_OR_DRONE_PRIVATE_KEY>
GAS_LIMIT=500000
GAS_PRICE_GWEI=20

# ==============================================================================
# IPFS Configuration
# ==============================================================================
